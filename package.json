{
  "name": "@obvi/feedback-sdk",
  "version": "1.5.0-beta.2",
  "description": "Embeddable browser feedback widget — drop into any web app to collect user feedback powered by Obvious",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": "./dist/index.global.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "bun test tests/unit/",
    "test:unit": "bun test tests/unit/",
    "test:src": "bun test src/",
    "test:typecheck": "bunx tsc --noEmit",
    "test:e2e": "bunx playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:live": "bunx playwright test --config tests/e2e/playwright.config.ts tests/e2e/specs/live-obvious.spec.ts",
    "test:all": "bun run test:typecheck && bun run test:unit && bun run build && bun run test:e2e",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "feedback",
    "widget",
    "bug-report",
    "obvious",
    "sdk",
    "browser"
  ],
  "author": "Obvious <hello@obvious.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlatFilers/obvious-feedback-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/FlatFilers/obvious-feedback-sdk/issues"
  },
  "homepage": "https://github.com/FlatFilers/obvious-feedback-sdk#readme",
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@playwright/test": "^1.59.1",
    "bun-types": "^1.2.23",
    "tsup": "^6.7.0",
    "typescript": "^5.4.5"
  }
}
